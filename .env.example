# ──────────────────────────────────────────────────────────────────────────────
#  GhostInTheCodebase — environment template
#  Copy to .env and fill in. Reference only — the real .env is gitignored.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# Ownership enforcement on the invoices API:
#   on  → shipped state: cross-owner read = 403 (what the suite targets)
#   off → BOLA hole live (demo narrative only — never for real use)
SECURE_MODE=on

# Auto-provided on Vercel; local fallback is http://localhost:3000.
# VERCEL_URL=

# ── Ghost Cloud — Database (Neon PostgreSQL) ─────────────────────────────────
DATABASE_URL=

# ── Ghost Cloud — Auth (GitHub OAuth App) ────────────────────────────────────
# Callback URIs: {base}/api/auth/github/callback (localhost + production)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Ghost Cloud — Session signing ────────────────────────────────────────────
# Generate: node -e "require('crypto').randomBytes(32).toString('hex')"
SESSION_SECRET=

# ── Ghost Local — CLI (set after device pairing) ─────────────────────────────
GHOST_API_URL=http://localhost:3000
# GHOST_DEVICE_TOKEN=       # issued by the pairing flow — never commit
